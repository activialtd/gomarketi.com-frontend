{
  "expo": {
    "name": "consumer-app",
    "slug": "gomarketi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moseley-dev.gomarketi",
      "config": {
        "googleMapsApiKey": "AIzaSyD19FDbBgohT6OLpB21MkyGGa6RWrpkTn4"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false
    },
    "extra": {
      "apiUrl": "https://api-staging.gomarketi.com",
      "eas": {
        "projectId": "078981bd-5813-4f08-849d-e71871dcd6f4"
      }
    },
    "owner": "moseley_dev",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "GoMarketi uses your location to show nearby vendors and deliver to your door."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "GoMarketi uses your microphone to let you search by voice.",
          "speechRecognitionPermission": "GoMarketi uses speech recognition to turn what you say into a search."
        }
      ]
    ]
  }
}
